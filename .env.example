# Optional: real email auth + cross-device sync via Supabase.
# Copy to .env.local and fill in values from your Supabase project
# (Project Settings → API). Leave unset to use local-only auth.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
